# Tier A needs none of these; they exist for the Tier B API and are listed so the
# deployment story is explicit. No real secret ever belongs in this file.
DATABASE_URL=postgresql+psycopg://orbit:orbit@localhost:5432/orbit
SESSION_SECRET=
ARTIFACT_ROOT=./experiments/results
LOG_LEVEL=INFO
ENV=development
CORS_ORIGINS=
MAX_CONCURRENT_RUNS=2
