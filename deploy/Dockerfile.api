FROM python:3.12-slim@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63 AS builder
WORKDIR /build
COPY pyproject.toml ./
RUN pip install --no-cache-dir --prefix=/install \
    fastapi uvicorn[standard] sqlalchemy alembic "psycopg[binary]" argon2-cffi \
    pydantic pydantic-settings prometheus-client email-validator \
    numpy scipy pandas pyarrow matplotlib networkx

FROM python:3.12-slim@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63
RUN useradd --create-home --uid 10001 orbit
COPY --from=builder /install /usr/local
WORKDIR /app
COPY orbit/ ./orbit/
COPY api/ ./api/
COPY experiments/ ./experiments/
COPY alembic.ini ./
USER orbit
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
