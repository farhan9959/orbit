# Digests verified against the Docker Hub registry API on 2026-08-18: a HEAD of
#   /v2/library/<repo>/manifests/<digest>
# returned 200 for both. The previous node digest (sha256:9f6bf0b4...) returned 404 - it was
# a placeholder and this build could never have succeeded with it. Pin plus tag so a reader
# can see what the digest is meant to be; the digest is what Docker actually resolves.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /build
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
# Playwright's browser download is pointless in an image that only builds static assets, and
# it is ~150 MB. The E2E suite runs in CI and on a developer machine, never here.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY --from=builder /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
